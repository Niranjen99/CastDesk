<Project Sdk="WixToolset.Sdk/5.0.2">

  <!-- Builds CastDesk-<version>-x64.msi. Use build-installer.ps1, which publishes the app into
       payload\ first and passes the version through. -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildThisFileDirectory)payload</PayloadDir>
    <OutputName>CastDesk-$(Version)-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>Version=$(Version);PayloadDir=$(PayloadDir);AssetsDir=$(MSBuildThisFileDirectory)..\Assets</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Standard installer dialogs (progress, finish, cancel, errors) used by the custom welcome screen. -->
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <!-- The Windows Firewall rule that lets phones on the local network reach CastDesk. -->
    <PackageReference Include="WixToolset.Firewall.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
